{
	"name": "@twin.org/attestation-cli",
	"version": "0.9.1-next.3",
	"description": "Command line tool for creating and managing attestations.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iotaledger/twin-attestation.git",
		"directory": "apps/attestation-cli"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build\"",
		"merge-locales": "merge-locales",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run merge-locales && npm run validate-locales && npm run test:build && npm run test",
		"dist:no-test": "npm run clean && npm run build && npm run merge-locales"
	},
	"dependencies": {
		"@twin.org/core": "next",
		"@twin.org/crypto": "next",
		"@twin.org/cli-core": "next",
		"@twin.org/crypto-cli": "next",
		"@twin.org/data-json-ld": "next",
		"@twin.org/entity": "next",
		"@twin.org/entity-storage-connector-memory": "next",
		"@twin.org/attestation-connector-nft": "0.9.1-next.3",
		"@twin.org/identity-cli": "next",
		"@twin.org/identity-models": "next",
		"@twin.org/identity-connector-iota": "next",
		"@twin.org/nft-cli": "next",
		"@twin.org/nft-connector-iota": "next",
		"@twin.org/nft-models": "next",
		"@twin.org/nameof": "next",
		"@twin.org/vault-connector-entity-storage": "next",
		"@twin.org/vault-models": "next",
		"@twin.org/wallet-models": "next",
		"@twin.org/wallet-cli": "next",
		"commander": "15.0.0"
	},
	"devDependencies": {
		"@twin.org/merge-locales": "next",
		"@twin.org/nameof-transformer": "next",
		"@twin.org/nameof-vitest-plugin": "next",
		"@twin.org/validate-locales": "next",
		"@types/node": "26.1.1",
		"@vitest/coverage-v8": "4.1.10",
		"copyfiles": "2.4.1",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.12.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		}
	},
	"files": [
		"bin",
		"dist/es",
		"dist/types",
		"dist/locales",
		"locales",
		"docs"
	],
	"bin": {
		"twin-attestation": "bin/index.js"
	},
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"attestation",
		"verification",
		"claims",
		"trust"
	],
	"bugs": {
		"url": "git+https://github.com/iotaledger/twin-attestation/issues"
	},
	"homepage": "https://twindev.org"
}
