{
	"name": "@3sixty/attestation-connector-nft",
	"version": "0.20.0-next.0",
	"description": "Attestation connector for minting and resolving NFT-backed attestations.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/3sixtyglobal/attestation.git",
		"directory": "packages/attestation-connector-nft"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tspc",
		"dev": "nodemon --watch src --ext ts --exec \"pnpm run build\"",
		"test": "vitest --run --config ./vitest.config.ts --no-cache",
		"test:coverage": "vitest --run --coverage --config ./vitest.config.ts --no-cache",
		"test:build": "tspc -p ./tests/tsconfig.json --noEmit",
		"validate-locales": "validate-locales",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "pnpm run docs:clean && pnpm run docs:generate",
		"dist": "pnpm run clean && concurrently -g -n build,locales,types,test \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\" \"pnpm run test\"",
		"dist:no-test": "pnpm run clean && concurrently -g -n build,locales,types \"pnpm run build\" \"pnpm run validate-locales\" \"pnpm run test:build\""
	},
	"dependencies": {
		"@3sixty/attestation-models": "0.20.0-next.0",
		"@3sixty/core": "next",
		"@3sixty/data-json-ld": "next",
		"@3sixty/entity": "next",
		"@3sixty/identity-models": "next",
		"@3sixty/nameof": "next",
		"@3sixty/nft-models": "next",
		"@3sixty/standards-schema-org": "next",
		"@3sixty/standards-w3c-did": "next"
	},
	"devDependencies": {
		"@3sixty/entity-storage-connector-memory": "next",
		"@3sixty/entity-storage-models": "next",
		"@3sixty/identity-connector-entity-storage": "next",
		"@3sixty/nameof-transformer": "next",
		"@3sixty/nameof-vitest-plugin": "next",
		"@3sixty/nft-connector-entity-storage": "next",
		"@3sixty/validate-locales": "next",
		"@3sixty/vault-connector-entity-storage": "next",
		"@3sixty/vault-models": "next",
		"@3sixty/wallet-connector-entity-storage": "next",
		"@3sixty/wallet-models": "next",
		"@types/node": "26.6.2",
		"@vitest/coverage-v8": "5.0.1",
		"concurrently": "10.0.5",
		"copyfiles": "2.4.1",
		"dotenv": "18.0.2",
		"nodemon": "3.1.14",
		"rimraf": "6.1.3",
		"ts-patch": "4.0.1",
		"typedoc": "0.28.20",
		"typedoc-plugin-markdown": "4.13.1",
		"typescript": "6.0.3",
		"vitest": "5.0.1"
	},
	"main": "./dist/es/index.js",
	"types": "./dist/types/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/es/index.js",
			"default": "./dist/es/index.js"
		},
		"./locales/*.json": "./locales/*.json"
	},
	"files": [
		"dist/es",
		"dist/types",
		"locales",
		"docs"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"attestation",
		"nft",
		"tokens",
		"non-fungible",
		"assets",
		"verification",
		"claims",
		"trust",
		"connector",
		"adapter",
		"integration"
	],
	"bugs": {
		"url": "git+https://github.com/3sixtyglobal/attestation/issues"
	},
	"homepage": "https://3sixty.global"
}
